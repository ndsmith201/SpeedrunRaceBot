# Create a Discord application and bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token

# The game this bot's races are organized around.
RACE_GAME=Super Mario 64

# Optional. A shell command run when `/race create` is used. It runs from the
# project folder and must write exactly one new or changed seed file to `seeds/`.
# The command receives RACE_GAME, RACE_CATEGORY, and RACE_SEEDS_DIRECTORY as
# environment variables. Use the shell syntax for your operating system.
SEED_GENERATOR_COMMAND=

# Optional: set this to a server ID while developing for instant slash-command updates.
# Leave blank to register commands globally (which can take up to an hour to appear).
DISCORD_GUILD_ID=
