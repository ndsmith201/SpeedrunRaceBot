# Required, secret: token from https://discord.com/developers/applications.
# Never commit or share the real value.
DISCORD_TOKEN=replace_with_your_bot_token

# Required: game name displayed in race trackers and passed to seed callbacks.
RACE_GAME="Castlevania Symphony of the Night"

# Required for generated seeds and seed-bank refills. Runs from the project root
# and must write exactly one new or changed file to RACE_SEEDS_DIRECTORY.
# The callback receives the documented RACE_* environment variables.
SEED_GENERATOR_COMMAND="python tools/generate_race_seed.py"

# Optional: set this to a server ID while developing for instant slash-command updates.
# Leave blank to register commands globally (which can take up to an hour to appear).
DISCORD_GUILD_ID=

# Required: root directory containing the SotN randomizer's `randomize` script.
RANDO_PATH="C:/path/to/SotN-Randomizer/"

# Required: permanent output directory for generated PPF patch files.
PATCH_FOLDER="./patches/"

# Required: replay storage root; each race uses its Discord interaction ID as a subfolder.
REPLAYS_FOLDER=./replays/

# Required: base URL for the SotN race API, without a trailing endpoint path.
API_BASE_URL=https://replace-with-api-host.example

# Required, secret: API authorization value. Never commit or share the real value.
API_KEY=replace_with_your_api_key
